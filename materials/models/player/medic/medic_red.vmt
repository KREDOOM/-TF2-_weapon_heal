"VertexLitGeneric"
{
	"$basetexture" "models\player\medic\red\medic_red"
	"$bumpmap" "models\player\medic\medic_normal"

	// Phong paramaters
	"$phong" "1"
	"$phongdisablehalflambert" "1"
	"$phongexponent" "15"
	"$phongboost" ".7"
	"$phongfresnelranges" "[.3 1 8]"
	"$lightwarptexture" "models\player\pyro\lambert_lightwarp"

	// Rim lighting parameters
	"$rimlight" "1"
	"$rimlightexponent" "4"
	"$rimlightboost" "2"

	// Burn overlay
	"$detail" "effects\tiledfire\firelayeredslowtiled512"
	"$detailscale" "5"
	"$detailblendfactor" "0"
	"$detailblendmode" "6"

	// Cloaking
	"$cloakpassenabled" "1"

	"Proxies"
	{
		"invis"
		{
		}
		"AnimatedTexture"
		{
			"animatedtexturevar" "$detail"
			"animatedtextureframenumvar" "$detailframe"
			"animatedtextureframerate" "30"
		}
		"BurnLevel"
		{
			"resultVar" "$detailblendfactor"
		}
		"ConVarEx"
		{
 			"ConVar" "tf2c_player_nohalflambert"
  			"0"
  	  		{
  	   			"$PhongDisableHalfLambert"  "0"
  	   			"$LightWarpTexture"         "models\player\pyro\pyro_lightwarp"
  	  		}
  	 		"1"
  	 		{
  	 			"$PhongDisableHalfLambert"  "1"
   				"$LightWarpTexture"         "models\player\pyro\lambert_lightwarp"
  	 		}
		}
	}
}
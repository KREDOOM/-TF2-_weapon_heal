"VertexLitGeneric"
{
	"$basetexture"	"models\weapons\v_medigun\v_medigun_front"
	"$phongdisablehalflambert" "1"
	"$phong" "1"
	"$phongexponent" "5"
	
	"$phongboost" "3"	
	"$lightwarptexture" "models\lightwarps\weapon_lightwarp"
	"$phongfresnelranges"	"[.3 .5 3]"

	"$basephongexponent" "5"
	"$basephongboost" "5"

	"$basemapalphaphongmask" "1"
	
	"$rimlight" "2"						
	"$rimlightexponent" "20"				
	"$rimlightboost" "1"

	"$glowcolor" "1"

	// Cloaking
	"$cloakPassEnabled" "1"

    "Proxies"
    {
		"invis"
		{
		}
		"ModelGlowColor"
		{
			"resultVar" "$glowcolor"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$selfillumtint"
		}
		"Equals"
		{
			"srcVar1"  "$glowcolor"
			"resultVar" "$color2"
		}
	}
}